<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Image to ICO Converter" Height="300" Width="450"
        AllowDrop="True" 
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        Background="#F8F8F8"
        WindowStartupLocation="CenterScreen">

    <Border BorderBrush="#CCCCCC" BorderThickness="2" CornerRadius="8" 
            Margin="20" Background="White" 
            AllowDrop="True" Drop="Window_Drop">

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Margin="30">

            <!-- Icon/Visual Indicator (using a simple path for aesthetics) -->
            <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" 
                  Fill="#4CAF50" Stretch="Uniform" Width="60" Height="60" 
                  Margin="0,0,0,20" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <RotateTransform Angle="45"/>
                </Path.RenderTransform>
            </Path>

            <!-- Instructions for Drag and Drop -->
            <TextBlock Text="Drag and Drop PNG or JPG files here" 
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="#333333" HorizontalAlignment="Center"/>

            <TextBlock Text="Files will be converted to multi-resolution .ico files (256x256)" 
                       FontSize="12" Foreground="#666666" Margin="0,5,0,0" 
                       HorizontalAlignment="Center"/>

            <!-- Status Text Block for feedback -->
            <TextBlock x:Name="StatusTextBlock" 
                       Text="" 
                       FontSize="14" 
                       Foreground="#007BFF" 
                       Margin="0,20,0,0" 
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"/>

        </StackPanel>
    </Border>
</Window>